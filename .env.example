# Test keys from the Stripe Dashboard: Developers, API keys, with Test mode on.
# The secret starts with sk_test_. The publishable key starts with pk_test_.
# Live keys can sit in this file too. The shop uses the test keys unless the process has STRIPE_ALLOW_LIVE=1.
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# STRIPE_LIVE_SECRET_KEY=sk_live_replace_me
# STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Signing secret printed by `stripe listen`, or from the webhook endpoint in the Stripe Dashboard.
# STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Test key from the Scalable Press account. It starts with test_.
# The live key can stay in this file. The shop uses the test key unless the process has SCALABLEPRESS_ALLOW_LIVE=1.
SCALABLEPRESS_TEST_API_KEY=test_replace_me
# SCALABLEPRESS_LIVE_API_KEY=live_replace_me
# Older name. Still read if the test or live key above is unset.
# SCALABLEPRESS_API_KEY=test_replace_me
# Optional. Test and live designs are separate. Set this when the test account has its own Trail Shirt design.
# SCALABLEPRESS_DESIGN_TRAIL_SHIRT=
# Optional. Changes the shipping estimate on npm run quote:print.
# SCALABLEPRESS_QUOTE_CITY=Lexington
# SCALABLEPRESS_QUOTE_STATE=KY
# SCALABLEPRESS_QUOTE_ZIP=40507
